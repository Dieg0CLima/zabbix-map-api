# Copie para .env e preencha os valores antes de subir o servidor
# cp .env.production.example .env

# --- Banco de dados ---
DB_USERNAME=zabbix_map
DB_PASSWORD=TROQUE_SENHA_DB

# Nomes dos bancos (pode deixar os defaults)
DB_NAME=zabbix_map_api_production
DB_CACHE_NAME=zabbix_map_api_production_cache
DB_QUEUE_NAME=zabbix_map_api_production_queue
DB_CABLE_NAME=zabbix_map_api_production_cable

# --- Segurança ---
# Gere com: docker compose -f docker-compose.prod.yml run --rm api rails secret
SECRET_KEY_BASE=GERE_COM_RAILS_SECRET

# Gere um segundo valor com o mesmo comando
DEVISE_JWT_SECRET_KEY=GERE_COM_RAILS_SECRET

# Gere com: docker compose -f docker-compose.prod.yml run --rm api rails db:encryption:init
# Copie os valores que aparecerem
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Tenancy ---
TENANCY_MODE=single
# TENANCY_ORGANIZATION_ID=1   # necessário se TENANCY_MODE=single e houver mais de uma org

# --- Usuários iniciais (seed) ---
DEFAULT_ADMIN_EMAIL=admin@zabbix-map.local
DEFAULT_ADMIN_PASSWORD=TROQUE_SENHA_ADMIN
DEFAULT_ORG_ADMIN_EMAIL=org-admin@zabbix-map.local
DEFAULT_ORG_ADMIN_PASSWORD=TROQUE_SENHA_ORG

# --- Porta exposta ---
API_PORT=80

# --- Controle de boot ---
DB_RESET=false      # true apenas para recriar o banco do zero
RUN_DB_SEED=true    # mude para false após o primeiro boot bem-sucedido
